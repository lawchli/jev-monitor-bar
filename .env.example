# No TypeSafe key is needed by the monitor. Only the host uses one.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=choose-in-your-host
# Optional overrides; defaults are per-platform (see JEV_MONITOR_AGENT_PROMPT.md, 平台支持策略).
# Windows: %LOCALAPPDATA%\jev-monitor-bar  macOS: ~/Library/Application Support/jev-monitor-bar
# Linux: ${XDG_STATE_HOME:-~/.local/state}/jev-monitor-bar
# JEV_MONITOR_HOME=
# JEV_MONITOR_SESSION=
