{
  "name": "jev-monitor-bar",
  "version": "0.1.0",
  "private": true,
  "description": "Local, read-only TypeSafe decision and execution monitor",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "start": "node scripts/launch.mjs",
    "schema:export": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.0.0",
    "esbuild": "^0.27.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.19.0"
}
